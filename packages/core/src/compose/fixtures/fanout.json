		{
			"from": { "node": "map/fix_until_green/check", "port": "text" },
			"kind": "data",
			"to": { "node": "map/fix_until_green/loop", "port": "text" }
		},
		{
			"from": { "node": "map/fix_until_green/check", "port": "logs" },
			"kind": "data",
			"to": { "node": "map/fix_until_green/loop", "port": "logs" }
		},
		{
			"from": { "node": "map/fix_until_green/loop", "port": "ok" },
			"kind": "data",
			"to": { "node": "map/fix_until_green/loop/loop_not", "port": "value" }
		},
		{
			"from": { "node": "map/fix_until_green/loop", "port": "logs" },
			"kind": "data",
			"to": { "node": "map/fix_until_green/loop/task", "port": "failures" }
