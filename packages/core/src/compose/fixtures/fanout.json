{
	"composition": { "id": "fanout", "pack": "fixtures", "version": "0.1.0" },
	"edges": [
		{
			"from": { "node": "map", "port": "item" },
			"kind": "data",
			"to": { "node": "map/task", "port": "model" }
		},
		{
			"from": { "node": "map/task", "port": "text" },
			"kind": "data",
			"to": { "node": "map/fix_until_green/check", "port": "text" }
