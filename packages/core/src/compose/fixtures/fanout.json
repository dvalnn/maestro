	"emitter": { "name": "@maestro/sdk", "version": "0.1.0" },
	"irVersion": "1.0",
	"nodes": [
		{
			"cardinality": { "exact": 2 },
			"id": "map",
			"inner": { "item": { "type": "string" } },
			"items": ["small", "large"],
			"kind": "map",
			"members": { "result": "map/fix_until_green/loop" },
			"onError": "settle",
			"out": {
				"results": {
					"items": {
						"additionalProperties": false,
						"oneOf": [
							{
								"properties": {
									"outcome": { "const": "ok" },
									"reason": false,
									"value": true
								},
								"required": ["value"]
							},
							{
								"properties": {
									"outcome": { "enum": ["rejected", "failed"] },
									"reason": true
								},
								"required": ["reason"]
							},
							{ "properties": { "outcome": { "const": "skipped" } } }
						],
						"properties": {
							"outcome": { "enum": ["ok", "skipped", "rejected", "failed"] },
							"reason": { "type": "string" },
							"value": {
								"properties": {
									"result": {
										"properties": {
											"logs": { "type": "string" },
											"text": { "type": "string" }
										},
										"type": "object"
									}
								},
								"type": "object"
							}
						},
						"required": ["outcome"],
						"type": "object"
					},
					"type": "array"
				}
			}
		},
		{
			"id": "map/task",
			"in": { "model": { "type": "string" }, "prompt": { "type": "string" } },
			"kind": "fake.task",
			"literals": { "prompt": "write it" },
			"out": { "text": { "type": "string" } }
		},
		{
			"id": "map/fix_until_green/check",
			"in": { "text": { "type": "string" } },
			"kind": "fake.check",
			"out": { "logs": { "type": "string" }, "text": { "type": "string" } }
		},
		{
			"cardinality": { "upTo": 2 },
			"id": "map/fix_until_green/loop",
			"in": { "logs": { "type": "string" }, "text": { "type": "string" } },
			"inner": {
				"index": { "type": "integer" },
				"logs": { "type": "string" },
				"ok": { "type": "boolean" },
				"reason": { "type": "string" },
				"text": { "type": "string" }
			},
			"kind": "loop",
			"members": { "result": "map/fix_until_green/loop/check" },
			"out": { "logs": { "type": "string" }, "text": { "type": "string" } },
			"test": {
				"at": "start",
				"port": { "node": "map/fix_until_green/loop/loop_not", "port": "value" }
			},
			"tolerate": "rejected"
		},
		{
			"id": "map/fix_until_green/loop/loop_not",
			"in": { "value": { "type": "boolean" } },
			"kind": "code",
			"out": { "value": { "type": "boolean" } },
			"worker": {
				"codeHash": "maestro:stdlib@0.1.0",
				"export": "not",
				"module": "maestro:stdlib",
				"runtime": "ts"
			}
		},
		{
			"id": "map/fix_until_green/loop/task",
			"in": {
				"failures": { "type": "string" },
				"index": { "type": "integer" },
				"prompt": { "type": "string" }
			},
			"kind": "fake.task",
			"literals": { "prompt": "write it" },
			"out": { "text": { "type": "string" } }
		},
		{
			"id": "map/fix_until_green/loop/check",
			"in": { "text": { "type": "string" } },
			"kind": "fake.check",
			"out": { "logs": { "type": "string" }, "text": { "type": "string" } }
		},
		{
			"fanin": true,
			"id": "firstOk",
			"in": {
				"results": {
					"items": {
						"additionalProperties": false,
						"oneOf": [
							{
								"properties": {
									"outcome": { "const": "ok" },
									"reason": false,
									"value": true
								},
								"required": ["value"]
							},
							{
								"properties": {
									"outcome": { "enum": ["rejected", "failed"] },
									"reason": true
								},
								"required": ["reason"]
							},
							{ "properties": { "outcome": { "const": "skipped" } } }
						],
						"properties": {
							"outcome": { "enum": ["ok", "skipped", "rejected", "failed"] },
							"reason": { "type": "string" },
							"value": {
								"properties": {
									"result": {
										"properties": {
											"logs": { "type": "string" },
											"text": { "type": "string" }
										},
										"type": "object"
									}
								},
								"type": "object"
							}
						},
						"required": ["outcome"],
						"type": "object"
					},
					"type": "array"
				}
			},
			"kind": "code",
			"out": {
				"value": {
					"properties": {
						"result": {
							"properties": {
								"logs": { "type": "string" },
								"text": { "type": "string" }
							},
							"type": "object"
						}
					},
					"type": "object"
				}
			},
			"worker": {
				"codeHash": "maestro:stdlib@0.1.0",
				"export": "firstOk",
				"module": "maestro:stdlib",
				"runtime": "ts"
			}
		}
	],
	"result": { "node": "firstOk" },
	"scopes": [
		{
			"composition": "fix_until_green",
			"id": "map/fix_until_green",
			"ports": { "draft": { "type": "string" }, "prompt": { "type": "string" } }
		}
	]
}
