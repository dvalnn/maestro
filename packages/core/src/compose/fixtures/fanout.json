			"kind": "data",
			"to": { "node": "map/fix_until_green/loop/task", "port": "index" }
		},
		{
			"from": { "node": "map/fix_until_green/loop/task", "port": "text" },
			"kind": "data",
			"to": { "node": "map/fix_until_green/loop/check", "port": "text" }
		},
		{
