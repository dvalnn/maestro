{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://maestro.invalid/ir/1.schema.json",
	"title": "maestro IR 1.x",
	"description": "The language-neutral form of a graph. Structural rules a schema cannot express (unique ids, resolvable references, port feeds, group containment, acyclicity) are listed in packages/ir/README.md and enforced by the validator.",
	"type": "object",
	"required": [
		"irVersion",
		"composition",
		"emitter",
		"scopes",
		"nodes",
		"edges",
		"result"
	],
	"additionalProperties": false,
	"properties": {
		"irVersion": {
			"description": "The IR versions this schema accepts. Bumped together with IR_VERSION.",
			"enum": ["1.0"]
		},
		"composition": {
			"type": "object",
			"required": ["id", "version", "pack"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/name" },
				"version": { "type": "string", "minLength": 1 },
				"pack": { "$ref": "#/$defs/name" },
				"doc": { "type": "string" }
			}
		},
		"emitter": {
			"type": "object",
			"required": ["name", "version"],
			"additionalProperties": false,
			"properties": {
				"name": { "type": "string", "minLength": 1 },
				"version": { "type": "string", "minLength": 1 },
				"sourceHash": { "type": "string", "minLength": 1 }
			}
		},
		"scopes": { "type": "array", "items": { "$ref": "#/$defs/scope" } },
		"nodes": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/node" }
		},
		"edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
		"result": {
			"description": "The node the build returned, where the result rule starts (architecture 7).",
			"type": "object",
			"required": ["node"],
			"additionalProperties": false,
			"properties": { "node": { "$ref": "#/$defs/id" } }
		}
	},
	"$defs": {
		"name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
		"id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
		},
		"portName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
		"qualifiedName": {
			"description": "<namespace>.<name>: a host node kind, or an x-maestro-type name.",
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
		},
		"schema": {
			"description": "A JSON Schema (draft 2020-12) document. Opaque to the IR validator.",
			"type": ["object", "boolean"]
		},
		"ports": {
			"type": "object",
			"propertyNames": { "$ref": "#/$defs/portName" },
			"additionalProperties": { "$ref": "#/$defs/schema" }
		},
		"portRef": {
			"type": "object",
			"required": ["node", "port"],
			"additionalProperties": false,
			"properties": {
				"node": { "$ref": "#/$defs/id" },
				"port": { "$ref": "#/$defs/portName" }
			}
		},
		"workerRef": {
			"type": "object",
			"required": ["runtime", "module", "export", "codeHash"],
			"additionalProperties": false,
			"properties": {
				"runtime": { "type": "string", "minLength": 1 },
				"module": { "type": "string", "minLength": 1 },
				"export": { "type": "string", "minLength": 1 },
				"codeHash": { "type": "string" }
			},
			"if": {
				"required": ["module"],
				"properties": { "module": { "const": "maestro:stdlib" } }
			},
			"then": {
				"properties": { "codeHash": { "$ref": "#/$defs/stdlibHash" } }
			},
			"else": {
				"properties": { "codeHash": { "$ref": "#/$defs/contentHash" } }
			}
		},
		"contentHash": {
			"description": "sha256: plus 64 lowercase hex digits.",
			"type": "string",
			"pattern": "^sha256:[0-9a-f]{64}$"
		},
		"stdlibHash": {
			"description": "maestro:stdlib@<semver>: the one code hash that is not a content hash (ADR 0008).",
			"type": "string",
			"pattern": "^maestro:stdlib@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
		},
		"cardinality": {
			"oneOf": [
				{
					"type": "object",
					"required": ["exact"],
					"additionalProperties": false,
					"properties": { "exact": { "type": "integer", "minimum": 0 } }
				},
				{
					"type": "object",
					"required": ["upTo"],
					"additionalProperties": false,
					"properties": { "upTo": { "type": "integer", "minimum": 1 } }
				}
			]
		},
		"tolerate": {
			"description": "Admit a rejected upstream. failed and skipped are never tolerable.",
			"const": "rejected"
		},
		"scope": {
			"type": "object",
			"required": ["id", "composition", "ports"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"composition": { "$ref": "#/$defs/name" },
				"ports": { "$ref": "#/$defs/ports" }
			}
		},
		"node": {
			"type": "object",
			"required": ["id", "kind"],
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"kind": {
					"anyOf": [
						{ "enum": ["code", "assert", "map", "seq", "repeat"] },
						{
							"description": "A host kind, namespaced as <host>.<kind>.",
							"$ref": "#/$defs/qualifiedName"
						}
					]
				},
				"tag": {
					"description": "A human label used in records. Not an identity.",
					"type": "string",
					"minLength": 1
				},
				"source": {
					"type": "object",
					"required": ["file", "line"],
					"additionalProperties": false,
					"properties": {
						"file": { "type": "string", "minLength": 1 },
						"line": { "type": "integer", "minimum": 1 },
						"column": { "type": "integer", "minimum": 1 }
					}
				},
				"in": { "$ref": "#/$defs/ports" },
				"out": {
					"$ref": "#/$defs/ports",
					"propertyNames": {
						"description": "Every node has the implicit outputs outcome, ok and reason.",
						"not": { "enum": ["outcome", "ok", "reason"] }
					}
				},
				"literals": {
					"type": "object",
					"propertyNames": { "$ref": "#/$defs/portName" }
				}
			},
			"allOf": [
				{
					"if": { "properties": { "kind": { "const": "code" } } },
					"then": { "$ref": "#/$defs/codeNode" }
				},
				{
					"if": { "properties": { "kind": { "const": "assert" } } },
					"then": { "$ref": "#/$defs/assertNode" }
				},
				{
					"if": { "properties": { "kind": { "const": "map" } } },
					"then": { "$ref": "#/$defs/mapNode" }
				},
				{
					"if": { "properties": { "kind": { "const": "seq" } } },
					"then": { "$ref": "#/$defs/seqNode" }
				},
				{
					"if": { "properties": { "kind": { "const": "repeat" } } },
					"then": { "$ref": "#/$defs/repeatNode" }
				},
				{
					"if": { "properties": { "kind": { "pattern": "\\." } } },
					"then": { "$ref": "#/$defs/hostNode" }
				}
			],
			"unevaluatedProperties": false
		},
		"codeNode": {
			"required": ["worker", "pure"],
			"properties": {
				"worker": { "$ref": "#/$defs/workerRef" },
				"pure": { "type": "boolean" },
				"reads": { "type": "array", "items": { "type": "string" } },
				"writes": { "type": "array", "items": { "type": "string" } },
				"fanin": { "type": "boolean" },
				"timeout": {
					"description": "Milliseconds the node may run before it settles failed. None when absent.",
					"type": "integer",
					"minimum": 1,
					"maximum": 2147483647
				}
			}
		},
		"assertNode": {
			"required": ["message", "onFail"],
			"properties": {
				"message": { "type": "string", "minLength": 1 },
				"onFail": { "enum": ["rejected", "failed"] }
			}
		},
		"group": {
			"required": ["inner", "members", "cardinality"],
			"properties": {
				"inner": { "$ref": "#/$defs/ports" },
				"members": {
					"description": "Result name to body node id. One entry for a body with one result.",
					"type": "object",
					"minProperties": 1,
					"propertyNames": { "$ref": "#/$defs/portName" },
					"additionalProperties": { "$ref": "#/$defs/id" }
				},
				"cardinality": { "$ref": "#/$defs/cardinality" }
			}
		},
		"mapNode": {
			"$ref": "#/$defs/group",
			"required": ["onError"],
			"properties": {
				"items": { "type": "array" },
				"key": { "$ref": "#/$defs/workerRef" },
				"onError": { "enum": ["settle", "propagate"] }
			}
		},
		"seqNode": {
			"$ref": "#/$defs/group",
			"properties": {
				"items": { "type": "array" },
				"until": { "$ref": "#/$defs/portRef" }
			}
		},
		"repeatNode": {
			"$ref": "#/$defs/group",
			"properties": {
				"until": { "$ref": "#/$defs/portRef" },
				"tolerate": { "$ref": "#/$defs/tolerate" }
			}
		},
		"hostNode": {
			"properties": {
				"config": { "type": "object" }
			}
		},
		"edge": {
			"type": "object",
			"required": ["kind", "from", "to"],
			"properties": {
				"kind": { "enum": ["data", "collect", "control"] }
			},
			"allOf": [
				{
					"if": { "properties": { "kind": { "enum": ["data", "collect"] } } },
					"then": {
						"properties": {
							"from": { "$ref": "#/$defs/portRef" },
							"to": { "$ref": "#/$defs/portRef" }
						}
					}
				},
				{
					"if": { "properties": { "kind": { "const": "control" } } },
					"then": {
						"properties": {
							"from": {
								"type": "object",
								"required": ["node"],
								"additionalProperties": false,
								"properties": {
									"node": { "$ref": "#/$defs/id" },
									"port": { "$ref": "#/$defs/portName" }
								}
							},
							"to": {
								"type": "object",
								"required": ["node"],
								"additionalProperties": false,
								"properties": { "node": { "$ref": "#/$defs/id" } }
							},
							"tolerate": { "$ref": "#/$defs/tolerate" }
						},
						"if": { "properties": { "from": { "required": ["port"] } } },
						"then": { "not": { "required": ["tolerate"] } }
					}
				}
			],
			"unevaluatedProperties": false
		}
	}
}
