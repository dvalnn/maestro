			"id": "summary",
			"kind": "code",
			"in": { "text": { "type": "string" } },
			"out": { "summary": { "type": "string" } },
			"worker": {
				"runtime": "ts",
				"module": "guards.ts",
				"export": "summarize",
				"codeHash": "sha256:50c022de954262e176f3c597f70204e1f960e42c633f5fc8c3fa7e455b64db9b"
