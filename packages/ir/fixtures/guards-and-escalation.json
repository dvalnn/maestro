{
	"irVersion": "1.0",
	"composition": {
		"id": "guards-and-escalation",
		"version": "0.1.0",
		"pack": "fixtures",
		"doc": "Split work into an unknown number of parts, merge them, then try sizes in order until one is ok. A gate asserts the outcome, and a summary is written either way."
	},
	"emitter": { "name": "hand", "version": "1", "sourceHash": "sha256:3333" },
	"scopes": [],
	"nodes": [
