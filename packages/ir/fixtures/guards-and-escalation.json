							},
							{
								"required": ["reason"],
								"properties": {
									"outcome": { "enum": ["rejected", "failed"] },
									"reason": true
								}
							},
							{ "properties": { "outcome": { "const": "skipped" } } }
						]
					}
				}
			},
			"members": { "result": "each/work" }
		},
		{
			"id": "each/work",
			"kind": "fake.task",
			"in": { "prompt": { "type": "string" } },
			"out": { "text": { "type": "string" } }
		},
		{
			"id": "merge",
			"kind": "code",
			"in": {
				"parts": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["outcome"],
						"additionalProperties": false,
						"properties": {
							"outcome": { "enum": ["ok", "skipped", "rejected", "failed"] },
							"value": { "type": "object" },
							"reason": { "type": "string" }
						},
						"oneOf": [
							{
								"required": ["value"],
								"properties": {
									"outcome": { "const": "ok" },
									"value": true,
									"reason": false
								}
							},
							{
								"required": ["reason"],
								"properties": {
									"outcome": { "enum": ["rejected", "failed"] },
									"reason": true
								}
							},
							{ "properties": { "outcome": { "const": "skipped" } } }
						]
					}
				},
				"separator": { "type": "string" }
			},
			"literals": { "separator": "\n" },
			"out": {
				"text": { "type": "string" },
				"nonEmpty": { "type": "boolean" }
			},
			"worker": {
				"runtime": "ts",
				"module": "guards.ts",
				"export": "merge",
