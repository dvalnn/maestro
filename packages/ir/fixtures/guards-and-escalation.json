			"from": { "node": "escalate", "port": "ok" },
			"to": { "node": "gate", "port": "cond" }
		},
		{
			"kind": "data",
			"from": { "node": "escalate", "port": "text" },
			"to": { "node": "summary", "port": "text" }
		},
		{
			"kind": "control",
			"from": { "node": "gate" },
			"to": { "node": "summary" },
