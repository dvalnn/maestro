{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!.claude", "!.zed", "!docs", "!.scratch"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["@maestro/cli", "@maestro/*/src/**"],
								"message": "Nothing imports cli, and packages are imported by their exports."
							},
							{
								"group": [
									"../../*/src/**",
									"../../*/fixtures/**",
									"../../../*/src/**",
									"../../../*/fixtures/**",
									"../../../../*/src/**",
									"../../../../*/fixtures/**"
								],
								"message": "Import another package by its name, never by a relative path."
							}
						]
					}
				}
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 10
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/ir/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@maestro/**"],
										"message": "ir imports no other package."
									},
									{
										"group": [
											"../../*/src/**",
											"../../*/fixtures/**",
											"../../../*/src/**",
											"../../../*/fixtures/**",
											"../../../../*/src/**",
											"../../../../*/fixtures/**"
										],
										"message": "Import another package by its name, never by a relative path."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/core/**",
				"packages/sdk/**",
				"packages/render-*/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@maestro/**", "!@maestro/ir"],
										"message": "core, sdk and render-* import ir alone."
									},
									{
										"group": [
											"../../*/src/**",
											"../../*/fixtures/**",
											"../../../*/src/**",
											"../../../*/fixtures/**",
											"../../../../*/src/**",
											"../../../../*/fixtures/**"
										],
										"message": "Import another package by its name, never by a relative path."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/host-repo/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@maestro/**",
											"!@maestro/ir",
											"!@maestro/core",
											"!@maestro/core/**"
										],
										"message": "host-repo imports core and ir alone."
									},
									{
										"group": [
											"../../*/src/**",
											"../../*/fixtures/**",
											"../../../*/src/**",
											"../../../*/fixtures/**",
											"../../../../*/src/**",
											"../../../../*/fixtures/**"
										],
										"message": "Import another package by its name, never by a relative path."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/host-repo-sdk/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@maestro/**",
											"!@maestro/ir",
											"!@maestro/sdk",
											"!@maestro/sdk/host"
										],
										"message": "host-repo-sdk imports sdk and ir alone, since packs bundle it."
									},
									{
										"group": [
											"../../*/src/**",
											"../../*/fixtures/**",
											"../../../*/src/**",
											"../../../*/fixtures/**",
											"../../../../*/src/**",
											"../../../../*/fixtures/**"
										],
										"message": "Import another package by its name, never by a relative path."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/host-repo-sdk/**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@maestro/**",
											"!@maestro/ir",
											"!@maestro/sdk",
											"!@maestro/sdk/**",
											"!@maestro/core/**",
											"!@maestro/host-repo",
											"!@maestro/host-repo/**",
											"!@maestro/testkit"
										],
										"message": "host-repo-sdk tests import sdk, ir, core, host-repo and testkit."
									},
									{
										"group": [
											"../../*/src/**",
											"../../*/fixtures/**",
											"../../../*/src/**",
											"../../../*/fixtures/**",
											"../../../../*/src/**",
											"../../../../*/fixtures/**"
										],
										"message": "Import another package by its name, never by a relative path."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/harness-*/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@maestro/**",
											"!@maestro/host-repo",
											"!@maestro/host-repo/**"
										],
										"message": "Harness adapters import host-repo alone."
									},
									{
										"group": [
											"../../*/src/**",
											"../../*/fixtures/**",
											"../../../*/src/**",
											"../../../*/fixtures/**",
											"../../../../*/src/**",
											"../../../../*/fixtures/**"
										],
										"message": "Import another package by its name, never by a relative path."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/cli/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@maestro/**",
											"!@maestro/core",
											"!@maestro/core/**",
											"!@maestro/sdk",
											"!@maestro/sdk/**",
											"!@maestro/ir",
											"!@maestro/render-*",
											"!@maestro/render-*/**",
											"!@maestro/host-repo",
											"!@maestro/host-repo/harness",
											"!@maestro/host-repo-sdk",
											"!@maestro/harness-*",
											"!@maestro/testkit"
										],
										"message": "cli imports core, sdk, ir, render-*, host-repo, host-repo-sdk and the harness adapters, and testkit in tests."
									},
									{
										"group": [
											"../../*/src/**",
											"../../*/fixtures/**",
											"../../../*/src/**",
											"../../../*/fixtures/**",
											"../../../../*/src/**",
											"../../../../*/fixtures/**"
										],
										"message": "Import another package by its name, never by a relative path."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/testkit/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@maestro/cli",
											"@maestro/render-*",
											"@maestro/*/src/**"
										],
										"message": "testkit imports only what a host or pack could."
									},
									{
										"group": [
											"../../*/src/**",
											"../../*/fixtures/**",
											"../../../*/src/**",
											"../../../*/fixtures/**",
											"../../../../*/src/**",
											"../../../../*/fixtures/**"
										],
										"message": "Import another package by its name, never by a relative path."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packs/*/src/**", "!packs/*/src/**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**",
											"!@maestro/sdk",
											"!@maestro/host-repo-sdk",
											"!node:*",
											"!./**"
										],
										"message": "A pack's source imports sdk, host-repo-sdk, node builtins and its own files alone, since it is bundled."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
