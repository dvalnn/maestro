{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun"]
	},
	"include": [
		".maestro/*.ts",
		"packages/*/src",
		"packs/*/src",
		"packs/*/acceptance",
		"scripts"
	]
}
