[Unit]
Description=One tick of the maestro factory

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/maestro-factory/repo
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env mise exec -- sh -c 'jj git fetch --remote origin && jj new main@origin && bun install --frozen-lockfile && exec bun scripts/factory/index.ts "$@"' factory --preset xscout
# The triage concert a tick starts is detached and must outlive the tick.
KillMode=process
